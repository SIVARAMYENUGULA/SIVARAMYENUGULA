# PlaceMux Frontend Environment Configuration

# QR pairing URL — ngrok tunnel (works from any network, iPhone can reach it)
VITE_NGROK_URL=https://transfer-grass-avoid.ngrok-free.dev

# Backend public URL — mobile needs this to connect Socket.IO via ngrok→Vite proxy→backend
VITE_BACKEND_PUBLIC_URL=https://transfer-grass-avoid.ngrok-free.dev

# API URL (local for desktop, via ngrok+proxy for mobile)
VITE_API_URL=http://localhost:5000/api

# App metadata
VITE_APP_NAME=PlaceMux
VITE_APP_ENV=development
